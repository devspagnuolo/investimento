# Copie para .env (fora do Git) e preencha. Não coloque senhas da XP aqui:
# o login é feito por você no próprio terminal MetaTrader 5.

# Ativa o adaptador XP / MetaTrader 5 no servidor do InvestAI.
INVESTAI_BROKER=mt5
# Segurança: envio real permanece bloqueado por padrão. Só altere para 1 após validar a conta, os símbolos, volumes e custos.
INVESTAI_LIVE_TRADING_ENABLED=0
# Número da conta MT5 esperada. O envio fica bloqueado se o terminal estiver em outra conta.
INVESTAI_MT5_ACCOUNT=
# Segredo compartilhado entre o InvestAI e a ponte (mínimo de 24 caracteres aleatórios).
# Gere com: node -e "console.log(crypto.randomBytes(24).toString('hex'))"
INVESTAI_BRIDGE_TOKEN=
INVESTAI_BRIDGE_URL=http://127.0.0.1:4174
INVESTAI_BRIDGE_PORT=4174

# Defina 1 somente depois de conferir que as posições do MT5 incluem toda a custódia da conta XP.
# Enquanto não for 1, o motor considera a carteira incompleta e não compra.
INVESTAI_MT5_CUSTODY_CONFIRMED=0
# Fuso do horário do servidor MT5 em relação ao UTC (horário de Brasília = -3).
INVESTAI_MT5_SERVER_UTC_OFFSET=-3
# Janela de envio em horário de Brasília, evitando leilões de abertura e fechamento.
INVESTAI_SESSION=10:10-16:50
# Caminho do terminal64.exe, se houver mais de um MT5 instalado.
INVESTAI_MT5_PATH=
